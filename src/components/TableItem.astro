---
const { year, title, affiliation, city, description, url } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-2 sm:gap-6 group pb-4 border-b border-gray-200">
    <div class="min-w-0">
        <p class="text-lg font-bold text-black tracking-tight">
            {title}{" "}
            <span class="text-gray-500 text-sm mt-1">
                {affiliation} - {" "}
                {
                    url
                        ? <a href={url} target="_blank">{city}</a>
                        : city
                }
            </span>
        </p>
        {
            description &&
                <div class="text-gray-500 text-sm mt-1">
                    {description}
                </div>
        }
    </div>

    <div class="shrink-0 text-gray-600 font-mono sm:text-right">
        {year}
    </div>
</div>
